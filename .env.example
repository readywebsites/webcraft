# GitHub API Token (5,000 requests/hour & Private Repo Access)
GITHUB_TOKEN=your_github_token_here

# Django Environment Configuration
DEBUG=True
SECRET_KEY=your_django_secret_key_here

# Domain Configuration
DOMAIN=webcraft.biz499.com
ALLOWED_HOSTS=webcraft.biz499.com,localhost,127.0.0.1,*
BACKEND_URL=https://webcraft.biz499.com

# PhonePe Standard Checkout (v2) Payment Gateway Configuration
PHONEPE_CLIENT_ID=your_phonepe_client_id_here
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret_here
PHONEPE_CLIENT_VERSION=1
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id_here
PHONEPE_ENV=PRODUCTION
PHONEPE_UPI_ID=your_upi_id@ybl
